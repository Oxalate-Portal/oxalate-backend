<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version> <!-- Keep this in sync with spring.boot.version -->
        <relativePath/>
    </parent>

    <groupId>io.oxalate</groupId>
    <artifactId>oxalate-service-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>oxalate-service-parent</name>
    <packaging>pom</packaging>

    <properties>
        <java.version>25</java.version>
        <spring.boot.version>4.1.1</spring.boot.version> <!-- Keep this in sync with the parent version -->
        <jjwt.version>0.13.0</jjwt.version>
        <swagger.version>2.2.55</swagger.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <apache-maven.version>3.6.0</apache-maven.version>
        <jboss-logging.component.version>3.0.4.Final</jboss-logging.component.version>
        <lombok.version>1.18.48</lombok.version>
        <jspecify.version>1.0.1</jspecify.version>

        <!--
            Ratcheted JaCoCo coverage floors. The target is 0.90 on every counter (see
            ../TODO-20260916.md); these defaults are 0.00 so that a module which has not opted in does
            not fail, and each module overrides them with its own measured actuals rounded down.
            The build therefore fails on a coverage regression without failing today.
            Raise these as coverage improves. Never lower one to make a build pass.
        -->
        <jacoco.min.instruction>0.00</jacoco.min.instruction>
        <jacoco.min.branch>0.00</jacoco.min.branch>
        <jacoco.min.line>0.00</jacoco.min.line>

        <checkstyle.plugin.version>3.6.0</checkstyle.plugin.version>
        <checkstyle.version>10.26.1</checkstyle.version>
        <checkstyle.config.location>${maven.multiModuleProjectDirectory}/config/checkstyle/checkstyle.xml</checkstyle.config.location>
        <checkstyle.suppressions.location>${maven.multiModuleProjectDirectory}/config/checkstyle/suppressions.xml</checkstyle.suppressions.location>
    </properties>

    <build>
        <plugins>
            <!-- Enable Lombok annotation processing with Java 25 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!-- version is managed by Spring Boot parent -->
                <configuration>
                    <release>${java.version}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${apache-maven.version}</version>
                <configuration>
                    <includes>
                        <include>**/*UTC.java</include>
                        <include>**/*ITC.java</include>
                        <include>**/*RTC.java</include>
                        <include>**/*TC.java</include>
                    </includes>
                </configuration>
            </plugin>
            <!--
                Style gate. The backend previously had no lint or static analysis of any kind: documentation/CODESTYLE.md
                and .editorconfig described the house style, but nothing in the build read either, so a style
                deviation could not be detected. The ruleset is intentionally small and is paired with a shrink-only
                suppressions file for the violations that already existed.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${checkstyle.plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>${checkstyle.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>${checkstyle.config.location}</configLocation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <consoleOutput>true</consoleOutput>
                    <failOnViolation>true</failOnViolation>
                    <violationSeverity>error</violationSeverity>
                    <!-- The ruleset is ours, not a shipped one; do not fall back to sun_checks.xml. -->
                    <propertyExpansion>checkstyle.suppressions.location=${checkstyle.suppressions.location}</propertyExpansion>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <!--
                        Runs after `report` in the same phase (execution order follows declaration
                        order). Before this existed, coverage was measured, uploaded as a CI
                        artifact, and never asserted against anything.
                    -->
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <haltOnFailure>true</haltOnFailure>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.min.instruction}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.min.branch}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.min.line}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <modules>
        <module>api</module>
        <module>service</module>
        <!-- Must stay last: it aggregates the coverage data the other modules produce. -->
        <module>coverage-report</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-annotations-jakarta</artifactId>
                <version>${swagger.version}</version>
            </dependency>
            <dependency>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4-runtime</artifactId>
                <version>4.13.2</version>
            </dependency>
            <dependency>
                <groupId>org.jboss.logging</groupId>
                <artifactId>jboss-logging-annotations</artifactId>
                <version>${jboss-logging.component.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jboss.logging</groupId>
                <artifactId>jboss-logging-processor</artifactId>
                <version>${jboss-logging.component.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.classgraph</groupId>
                <artifactId>classgraph</artifactId>
                <version>4.8.195</version>
            </dependency>
            <dependency>
                <groupId>org.checkerframework</groupId>
                <artifactId>checker-qual</artifactId>
                <version>4.2.3</version>
            </dependency>
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-annotations</artifactId>
                <version>${swagger.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
